{
  "name": "gemini-scanner-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "dry:scanner": "node scripts/dry_scanner.mjs",
    "validate:weekend": "node scripts/weekend_scanner_validation.mjs",
    "validate:open": "node scripts/open_market_validation.mjs",
    "validate:open:closed": "node scripts/open_market_validation.mjs --closed-ok",
    "validate:dashboard": "node scripts/dashboard_smoke_validation.mjs",
    "validate:all": "npm run validate:weekend && npm run validate:open:closed && npm run validate:dashboard && npm run validate:alpaca-audit && npm run validate:trading-safety && npm run validate:connect-safety && node --test",
    "alerts:scanner": "node scripts/scanner_alert_report.mjs",
    "validate:alpaca-audit": "node scripts/alpaca_audit_validation.mjs",
    "validate:trading-safety": "node scripts/trading_api_safety_validation.mjs",
    "watch:alpaca-api": "node scripts/alpaca_api_watcher.mjs",
    "watch:alpaca-api:install-cron": "node scripts/install_alpaca_api_watcher_cron.mjs",
    "validate:alpaca-api-watch": "node scripts/alpaca_api_watch_validation.mjs",
    "validate:connect-safety": "node scripts/connect_api_safety_validation.mjs",
    "plan:api-patch": "node scripts/plan_api_patch.mjs",
    "validate:api-patch-dashboard": "node --test test/api_patch_plan_dashboard.test.mjs",
    "approve:api-patch": "node scripts/approve_api_patch_plan.mjs",
    "validate:api-patch-approval": "node --test test/api_patch_approval_gate.test.mjs && node scripts/validate_api_patch_approval_gate.mjs",
    "validate:operator-approval-workflow": "node --test test/operator_approval_workflow.test.mjs",
    "validate:operator-approval-dashboard-panel": "node scripts/validate_operator_approval_dashboard_panel.mjs",
    "gate:paper-trading-readiness": "node scripts/paper_trading_readiness_gate.mjs",
    "plan:paper-trade-intent": "node scripts/paper_trade_intent_planner.mjs",
    "audit:paper-intent": "node scripts/audit_paper_trade_intent.mjs",
    "panel:paper-intent-audit": "node scripts/paper_trade_intent_audit_dashboard_panel.mjs",
    "intent:paper": "node scripts/create_paper_trade_intent.mjs",
    "dashboard:paper-intent-creation": "node scripts/paper_trade_intent_creation_dashboard.mjs",
    "panel:paper-intent-creation": "node scripts/paper_trade_intent_creation_dashboard_panel.mjs",
    "run:paper-intent-creation": "node scripts/run_paper_trade_intent_creation.mjs",
    "panel:paper-intent-creation-runner": "node scripts/paper_trade_intent_creation_runner_panel.mjs",
    "audit:paper-intent-creation-runner": "node scripts/audit_paper_trade_intent_creation_runner.mjs",
    "dashboard:paper-intent-creation-runner-audit": "node scripts/audit_paper_trade_intent_creation_runner.mjs --dashboard=true",
    "panel:paper-intent-creation-runner-audit": "node scripts/paper_trade_intent_creation_runner_audit_panel.mjs",
    "preview:paper-execution-payload": "node scripts/paper_trade_execution_payload_preview.mjs",
    "panel:paper-execution-payload": "node scripts/paper_trade_execution_payload_preview.mjs --panel=true",
    "preview:paper-sizing": "node scripts/paper_trade_sizing_preview.mjs",
    "panel:paper-sizing": "node scripts/paper_trade_sizing_preview.mjs --panel=true",
    "preview:paper-order-ticket": "node scripts/paper_trade_order_ticket_preview.mjs",
    "panel:paper-order-ticket": "node scripts/paper_trade_order_ticket_preview.mjs --panel=true",
    "store:paper-order-ticket": "node scripts/store_paper_trade_order_ticket.mjs",
    "dashboard:paper-order-ticket-store": "node scripts/store_paper_trade_order_ticket.mjs --dashboard=true",
    "panel:paper-order-ticket-store": "node scripts/paper_trade_order_ticket_store_panel.mjs",
    "preview:paper-fill": "node scripts/paper_trade_fill_simulation_preview.mjs",
    "panel:paper-fill": "node scripts/paper_trade_fill_simulation_preview.mjs --panel=true",
    "store:paper-fill": "node scripts/store_paper_trade_fill_simulation.mjs",
    "dashboard:paper-fill-store": "node scripts/store_paper_trade_fill_simulation.mjs --dashboard=true",
    "panel:paper-fill-store": "node scripts/paper_trade_fill_simulation_store_panel.mjs",
    "preview:paper-position-state": "node scripts/paper_trade_position_state_preview.mjs",
    "panel:paper-position-state": "node scripts/paper_trade_position_state_preview.mjs --panel=true",
    "store:paper-position-state": "node scripts/store_paper_trade_position_state.mjs",
    "dashboard:paper-position-state-store": "node scripts/store_paper_trade_position_state.mjs --dashboard=true",
    "panel:paper-position-state-store": "node scripts/store_paper_trade_position_state.mjs --panel=true",
    "dashboard:paper-lifecycle": "node scripts/paper_trade_lifecycle_dashboard.mjs",
    "panel:paper-lifecycle": "node scripts/paper_trade_lifecycle_dashboard.mjs --panel=true",
    "run:paper-lifecycle": "node scripts/run_paper_trade_lifecycle.mjs",
    "preview:paper-lifecycle-runner": "node scripts/run_paper_trade_lifecycle.mjs --preview=true",
    "panel:paper-lifecycle-runner": "node scripts/run_paper_trade_lifecycle.mjs --panel=true",
    "audit:paper-lifecycle-runner": "node scripts/audit_paper_trade_lifecycle_runner.mjs",
    "dashboard:paper-lifecycle-runner-audit": "node scripts/audit_paper_trade_lifecycle_runner.mjs --dashboard=true",
    "panel:paper-lifecycle-runner-audit": "node scripts/audit_paper_trade_lifecycle_runner.mjs --panel=true",
    "validate:paper-local-e2e": "node scripts/validate_paper_trade_local_lifecycle_e2e.mjs",
    "guard:paper-broker-adapter": "node scripts/paper_trade_broker_adapter_guard.mjs",
    "panel:paper-broker-adapter-guard": "node scripts/paper_trade_broker_adapter_guard.mjs --panel=true",
    "control:paper-execution-stack": "node scripts/paper_trade_execution_control_stack.mjs",
    "panel:paper-execution-stack": "node scripts/paper_trade_execution_control_stack.mjs --panel=true",
    "report:paper-readiness": "node scripts/paper_trade_readiness_report.mjs",
    "panel:paper-readiness": "node scripts/paper_trade_readiness_report.mjs --panel=true",
    "preflight:paper-broker-integration": "node scripts/paper_trade_broker_integration_preflight_stack.mjs",
    "panel:paper-broker-integration-preflight": "node scripts/paper_trade_broker_integration_preflight_stack.mjs --panel=true",
    "report:paper-module-completion": "node scripts/paper_trade_module_completion_report.mjs",
    "panel:paper-module-completion": "node scripts/paper_trade_module_completion_report.mjs --panel=true",
    "decision:paper-go-no-go": "node scripts/paper_trade_operator_go_no_go.mjs",
    "panel:paper-go-no-go": "node scripts/paper_trade_operator_go_no_go.mjs --panel=true",
    "lock:paper-broker-adapter": "node scripts/paper_broker_adapter_approval_lock.mjs",
    "panel:paper-broker-adapter-lock": "node scripts/paper_broker_adapter_approval_lock_panel.mjs",
    "diagnostics:paper-broker-null-adapter": "node -e \"import('./src/scanner/paper_broker_null_adapter.mjs').then(m=>console.log(JSON.stringify(m.getPaperBrokerNullAdapterDiagnostics(), null, 2)))\"",
    "diagnostics:paper-broker-adapter-contract": "node -e \"import('./src/scanner/paper_broker_adapter_contract.mjs').then(m=>console.log(JSON.stringify(m.getPaperBrokerAdapterContractDiagnostics(), null, 2)))\"",
    "diagnostics:paper-order-intent-adapter-preview-bridge": "node -e \"import('./src/scanner/paper_order_intent_adapter_preview_bridge.mjs').then(async m=>console.log(JSON.stringify(await m.getPaperOrderIntentAdapterPreviewBridgeDiagnostics(), null, 2)))\"",
    "diagnostics:paper-broker-adapter-approval-record-tool": "node src/scanner/paper_broker_adapter_approval_record_tool.mjs diagnostics",
    "approve:paper-broker-adapter": "node src/scanner/paper_broker_adapter_approval_record_tool.mjs approve",
    "diagnostics:alpaca-paper-broker-adapter": "node -e \"import('./src/scanner/alpaca_paper_broker_adapter.mjs').then(async m=>console.log(JSON.stringify(await m.getAlpacaPaperBrokerAdapterDiagnostics(), null, 2)))\"",
    "diagnostics:paper-order-submit-dry-run": "node -e \"import('./src/scanner/paper_order_submit_dry_run_preview.mjs').then(async m=>console.log(JSON.stringify(await m.getPaperOrderSubmitDryRunDiagnostics(), null, 2)))\"",
    "diagnostics:paper-trading-final-go-no-go": "node -e \"import('./src/scanner/paper_trading_final_go_no_go.mjs').then(async m=>console.log(JSON.stringify(await m.getPaperTradingFinalGoNoGoDiagnostics(), null, 2)))\"",
    "diagnostics:first-real-paper-order-test-gate": "node -e \"import('./src/scanner/first_real_paper_order_test_gate.mjs').then(async m=>console.log(JSON.stringify(await m.getFirstRealPaperOrderTestGateDiagnostics(), null, 2)))\"",
    "diagnostics:paper-trading-monitoring-kill-switch": "node src/scanner/paper_trading_monitoring_kill_switch.mjs status",
    "paper:kill-switch:disable": "node src/scanner/paper_trading_monitoring_kill_switch.mjs disable",
    "paper:kill-switch:enable-preview-only": "node src/scanner/paper_trading_monitoring_kill_switch.mjs enable-preview-only",
    "diagnostics:real-trading-conversion-lock": "node -e \"import('./src/scanner/real_trading_conversion_lock.mjs').then(m=>console.log(JSON.stringify(m.getRealTradingConversionLockDiagnostics(), null, 2)))\""
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "luxon": "^3.7.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  }
}
